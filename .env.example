# ===== Telegram bot =====
# Bot token from @BotFather. Keep it in .env only; .env is git-ignored.
BOT_TOKEN=
# Optional whitelist: comma-separated Telegram user ids. Empty = anyone can use the bot.
ALLOWED_USER_IDS=
# Users allowed to run /scan manually. Empty = every allowed user.
ADMIN_IDS=

# ===== Storage =====
DATA_DIR=data
DB_PATH=data/nftflip.sqlite3

# ===== Scanner =====
# Seconds between cycles. Hard-capped at 180 s (3 min) by the code.
SCAN_INTERVAL_SEC=120
# Adaptive night interval. Also capped at 180 s.
NIGHT_INTERVAL_SEC=180
NIGHT_START_HOUR=0
NIGHT_END_HOUR=8
# Your UTC offset for the night window (Kyiv = 2 in summer, 3 in winter).
TZ_OFFSET_HOURS=2
MAX_LISTINGS_PER_QUERY=30
MAX_WATCH_QUERIES=40
# Do not repeat the same gift+price too often (seconds).
SIGNAL_COOLDOWN_SEC=21600

# ===== Defaults for new users =====
DEFAULT_MIN_MARGIN_PCT=8
DEFAULT_BUDGET_TON=10
DEFAULT_DAILY_BUDGET_TON=50
# Conservative resale estimate: undercut the cheapest foreign ask by this %.
RESALE_DISCOUNT_PCT=3

# ===== TON -> USD (keyless) =====
TON_RATE_URL=https://tonapi.io/v2/rates?tokens=ton&currencies=usd
TON_RATE_TTL_SEC=600

# ===== HTTP =====
HTTP_TIMEOUT=15
# Optional proxy for every market, e.g. http://user:pass@host:port or socks5://host:port
HTTP_PROXY=

# ===== Portals =====
PORTALS_API_URL=https://portal-market.com/api
PORTALS_WEBAPP_URL=https://portal-market.com
# Defaults researched in October 2026. Verify before trading real money.
PORTALS_BUY_FEE_PCT=0
PORTALS_SELL_FEE_PCT=2
PORTALS_WITHDRAW_FEE_TON=0

# ===== Tonnel =====
TONNEL_API_URL=https://gifts2.tonnel.network/api
TONNEL_ORIGIN=https://market.tonnel.network
TONNEL_BUY_FEE_PCT=0.5
TONNEL_SELL_FEE_PCT=0.5
TONNEL_WITHDRAW_FEE_TON=0

# ===== MRKT =====
# Reading /gifts/saling needs auth. Choose ONE of:
#   1) MRKT_TOKEN (from DevTools / any community client),
#   2) MRKT_INIT_DATA (copied from the Mini App),
#   3) TG_API_ID + TG_API_HASH and `python run.py login` (auto-refreshes initData).
MRKT_API_BASE=https://api.tgmrkt.io/api/v1
MRKT_TOKEN=
MRKT_INIT_DATA=
MRKT_BOT_USERNAME=mrkt
MRKT_APP_SHORT_NAME=app
MRKT_WEBAPP_URL=https://cdn.tgmrkt.io/
MRKT_BUY_FEE_PCT=0
MRKT_SELL_FEE_PCT=0
MRKT_WITHDRAW_FEE_TON=0.17

# ===== Telegram user session (only for automatic MRKT initData refresh) =====
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=mrkt
INIT_DATA_TTL=1800

LOG_LEVEL=INFO
